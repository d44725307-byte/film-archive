# Cloudflare Pages 缓存策略
# ⚠️ JS/CSS 必须用 must-revalidate：文件名不变但内容每次部署都变，
#    若设长缓存会导致 CDN 一直发旧版本（曾踩过：app.js 被缓存 11 小时）
/samples/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/style.css
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/film-page.js
  Cache-Control: public, max-age=0, must-revalidate
/article.js
  Cache-Control: public, max-age=0, must-revalidate

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# HTML 不缓存
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
