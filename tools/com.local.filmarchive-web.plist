<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.filmarchive-web</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/python3</string>
    <string>-m</string>
    <string>http.server</string>
    <string>8091</string>
    <string>--bind</string>
    <string>0.0.0.0</string>
  </array>

  <!-- 开机（用户登录后）自动启动 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 意外退出自动重启 -->
  <key>KeepAlive</key>
  <true/>

  <!-- 工作目录 -->
  <key>WorkingDirectory</key>
  <string>/Users/apple/DSH/Gemini 3.6视觉模型/DeepSeek/film-archive</string>

  <!-- 日志 -->
  <key>StandardOutPath</key>
  <string>/tmp/filmarch-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/filmarch-launchd.err.log</string>
</dict>
</plist>
